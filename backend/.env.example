# LLM configuration for intent parsing & privacy guardrail
# Supports any OpenAI-compatible API (Google Gemini, OpenAI, OpenRouter, etc.)
# Get free Gemini API key at: https://aistudio.google.com
LLM_API_KEY=your-gemini-api-key-here
LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_MODEL=gemini-2.0-flash

# Security (generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
ENVIRONMENT=development
JWT_SECRET_KEY=replace-with-a-random-secret
SEED_DEMO_USERS=false

# Privacy Guardrail
GUARDRAIL_ENABLED=true           # Set to "false" to disable all guardrail checks
