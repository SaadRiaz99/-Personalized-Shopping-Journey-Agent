# LLM configuration for intent parsing & privacy guardrail
# Supports any OpenAI-compatible API (OpenAI, OpenRouter, local LLM, etc.)
LLM_API_KEY=sk-your-api-key-here
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# Privacy Guardrail
GUARDRAIL_ENABLED=true           # Set to "false" to disable all guardrail checks
